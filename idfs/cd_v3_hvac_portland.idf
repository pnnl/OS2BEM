    SET pacu_vav_bot_MAX_OA_FRAC = NULL,  !- Program Line 2
    ELSE,                    !- A4
    IF pacu_vav_bot_SUPPLY_FLOW > 0,  !- A5
    SET pacu_vav_bot_MAX_OA_FRAC =      0.9561 / pacu_vav_bot_SUPPLY_FLOW,  !- A6
