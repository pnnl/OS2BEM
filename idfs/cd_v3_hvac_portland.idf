    ENDIF,                   !- A9
    ENDIF;                   !- A10

EnergyManagementSystem:Program,
    OA_BASED_OPTIMUM_START_EMS_Program,  !- Name
    IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && OAT<23.9 && OAT>1.7,  !- Program Line 1
    SET CLGSETP_SCH_Actuator = 26.7,  !- Program Line 2
    SET HTGSETP_SCH_Actuator = 15.6,  !- A4
    SET CLGSETP_SCH_w_SB_Actuator = 26.7,  !- A5
    SET HTGSETP_SCH_w_SB_Actuator = 15.6,  !- A6
    ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && OAT<23.9 && OAT>1.7,  !- A7
    SET CLGSETP_SCH_Actuator = 26.7,  !- A8
    SET HTGSETP_SCH_Actuator = 15.6,  !- A9
    SET CLGSETP_SCH_w_SB_Actuator = 26.7,  !- A10
    SET HTGSETP_SCH_w_SB_Actuator = 15.6,  !- A11
    ELSE,                    !- A12
    SET CLGSETP_SCH_Actuator = NULL,  !- A13
    SET HTGSETP_SCH_Actuator = NULL,  !- A14
    SET CLGSETP_SCH_w_SB_Actuator = NULL,  !- A15
    SET HTGSETP_SCH_w_SB_Actuator = NULL,  !- A16
    ENDIF;                   !- A17

